# =============================================================================
# BhashaRakshak – Root Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bhasharakshak
POSTGRES_USER=bhasharakshak_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Backend ───────────────────────────────────────────────────────────────────
# Derived from above — the backend reads DATABASE_URL directly
DATABASE_URL=postgresql+asyncpg://bhasharakshak_user:CHANGE_ME_strong_password_here@localhost:5432/bhasharakshak

# Secret key for signing (min 32 chars, use: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Environment: development | staging | production
ENVIRONMENT=development

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated allowed origins (NO wildcard in production)
# Example production value: https://bhasharakshak.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Request size limit in bytes (default 1 MB)
MAX_REQUEST_SIZE_BYTES=1048576

# Rate limiting (per IP per minute)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ prefix means this IS safe to expose to the browser.
# Only put truly public values here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=BhashaRakshak
NEXT_PUBLIC_APP_VERSION=0.1.0
