# =============================================================================
# BhashaRakshak Frontend – Environment Variables Example
# Copy to .env.local and fill in your values.
# NEVER commit the .env.local file.
# =============================================================================

# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# DO NOT put database credentials, API keys, or backend secrets here!

# The base URL of the BhashaRakshak API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Application metadata
NEXT_PUBLIC_APP_NAME=BhashaRakshak
NEXT_PUBLIC_APP_VERSION=0.1.0
