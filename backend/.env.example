# =============================================================================
# BhashaRakshak Backend – Environment Variables Example
# Copy to .env and fill in your values.
# NEVER commit the .env file.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Full async PostgreSQL DSN
DATABASE_URL=postgresql+asyncpg://bhasharakshak_user:CHANGE_ME@localhost:5432/bhasharakshak

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS: comma-separated list of allowed origins. NO wildcards in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Limits ────────────────────────────────────────────────────────────────────
# Max request body size in bytes (default 1 MB)
MAX_REQUEST_SIZE_BYTES=1048576

# Rate limiting: requests per IP per window
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
