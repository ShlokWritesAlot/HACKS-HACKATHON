# BhashaRakshak Production Environment Secrets Template
# NEVER commit raw production values to git!

ENVIRONMENT=production
DEBUG=False

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Database & Cache (Internal Docker network only)
POSTGRES_USER=bhasha_prod_user
POSTGRES_PASSWORD=CHANGE_THIS_TO_SECURE_RANDOM_PASSWORD_IN_PRODUCTION
POSTGRES_DB=bhasharakshak

# Analyst Dashboard Authentication Key
ANALYST_SECRET_KEY=CHANGE_THIS_TO_STRONG_ANALYST_SECRET_KEY

# CORS Allowed Origins
CORS_ORIGINS=["https://bhasharakshak.gov.in", "https://app.bhasharakshak.in"]
